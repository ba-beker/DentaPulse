{
  "name": "@dentapulse/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @dentapulse/shared build && next dev --port 3000",
    "build": "pnpm --filter @dentapulse/shared build && next build",
    "start": "next start --port 3000",
    "typecheck": "pnpm --filter @dentapulse/shared build && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@dentapulse/shared": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "next-intl": "^4.3.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20.19.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
